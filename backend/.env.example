# === CertiMate Backend Environment Variables ===
# Copy this file to .env and fill in your values.
# .env is gitignored — keys stay on your machine only.

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/certimate-api_dev

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production

# --- AI / LLM API Keys ---
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx
GEMINI_API_KEY=AIza-xxx
VOYAGE_API_KEY=pa-xxx

# --- AI Model Defaults (can be overridden by ai_model_routings table) ---
# CLAUDE_MODEL=claude-sonnet-4-20250514
# OPENAI_MODEL=gpt-4o
# GEMINI_MODEL=gemini-2.0-flash

# --- RAG Parameters ---
# CHUNK_SIZE_TOKENS=512
# CHUNK_OVERLAP_TOKENS=64
# RETRIEVAL_TOP_K=10
