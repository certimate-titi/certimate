# Production environment — Cloud Run deployment
# Copy to .env.production and fill in values before `npm run build`

# Backend API URL (Cloud Run)
NEXT_PUBLIC_API_URL=https://certimate-63018063271.asia-east1.run.app/api/v1

# Firebase (optional for Google OAuth)
NEXT_PUBLIC_FIREBASE_API_KEY=""

# Gemini AI (server-side only, NOT exposed to client)
GEMINI_API_KEY=""

APP_URL="https://your-frontend-domain.web.app"
