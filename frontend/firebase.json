{
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/v1/**",
        "run": {
          "serviceId": "certimate-titi",
          "region": "asia-east1"
        }
      },
      {
        "source": "/super-admin/users/**",
        "destination": "/super-admin/users/detail/index.html"
      },
      {
        "source": "/super-admin/prompt-templates/**",
        "destination": "/super-admin/prompt-templates/detail/index.html"
      },
      {
        "source": "/edu-console/student/**",
        "destination": "/edu-console/student/detail/index.html"
      },
      {
        "source": "/resources/*/candidates",
        "destination": "/resources/detail/candidates/index.html"
      },
      {
        "source": "/resources/*/candidates/**",
        "destination": "/resources/detail/candidates/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|ico|png|jpg|jpeg|gif|svg|webp|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "emulators": {
    "hosting": {
      "port": 5010
    }
  }
}
