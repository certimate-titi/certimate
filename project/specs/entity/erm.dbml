// ============================================================
// Feedback System (Feature 17)
// ============================================================

Enum feedback_type {
  BUG
  FEATURE_REQUEST
  CONTENT_ERROR
  OTHER
}

Enum feedback_status {
  PENDING
  REVIEWING
  RESOLVED
  CLOSED
}

Table feedbacks {
  id uuid [pk, default: `gen_random_uuid()`]
  feedback_id varchar(50) [unique, not null, note: 'e.g. FB-001']
  user_id uuid [not null]
  type feedback_type [not null]
  subject varchar(100) [not null]
  content text [not null]
  status feedback_status [not null, default: 'PENDING']
  admin_reply text
  resolved_at timestamptz
  close_reason text
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Ref: feedbacks.user_id > users.id

Table feedback_attachments {
  id uuid [pk, default: `gen_random_uuid()`]
  feedback_id uuid [not null]
  file_path text [not null]
  file_size integer [not null, note: 'bytes']
  mime_type varchar(50) [not null]
  created_at timestamptz [default: `now()`]
}

Ref: feedback_attachments.feedback_id > feedbacks.id
