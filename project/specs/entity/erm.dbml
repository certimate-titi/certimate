// ============================================================
// Feedback System (Feature 17)
// ============================================================

Enum feedback_type {
  BUG
  FEATURE_REQUEST
  CONTENT_ERROR
  OTHER
}

Enum feedback_status {
  PENDING
  REVIEWING
  RESOLVED
  CLOSED
}

Table feedbacks {
  id uuid [pk, default: `gen_random_uuid()`]
  feedback_id varchar(50) [unique, not null, note: 'e.g. FB-001']
  user_id uuid [not null]
  type feedback_type [not null]
  subject varchar(100) [not null]
  content text [not null]
  status feedback_status [not null, default: 'PENDING']
  admin_reply text
  resolved_at timestamptz
  close_reason text
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Ref: feedbacks.user_id > users.id

Table feedback_attachments {
  id uuid [pk, default: `gen_random_uuid()`]
  feedback_id uuid [not null]
  file_path text [not null]
  file_size integer [not null, note: 'bytes']
  mime_type varchar(50) [not null]
  created_at timestamptz [default: `now()`]
}

Ref: feedback_attachments.feedback_id > feedbacks.id

// ============================================================
// Prompt Template Management (Feature 30)
// ============================================================

Enum prompt_category {
  safety
  knowledge
  exam
  teaching
  emotion
}

Enum ab_test_status {
  running
  completed
  cancelled
}

Table prompt_templates {
  id uuid [pk, default: `gen_random_uuid()`]
  template_id varchar(10) [unique, not null, note: 'e.g. S-01, K-01, T-02']
  name varchar(100) [unique, not null, note: '英文識別名 e.g. safety_router']
  display_name varchar(200) [not null, note: '中文顯示名 e.g. 三維度安全分類']
  category prompt_category [not null]
  model varchar(100) [not null, note: 'gemini-flash / claude-3.5-sonnet / vision / by-plan']
  max_tokens integer [not null]
  max_tokens_by_plan jsonb [note: '{"PRO_199":1024,"PRO_PLUS_399":2048,"ULTRA_1599":4096} — model=by-plan 時使用']
  temperature decimal(2,1) [not null, default: 0.5]
  system_prompt text [not null]
  user_prompt text [not null]
  variables jsonb [not null, default: '[]', note: '[{"name":"subject_name","description":"...","example":"..."}]']
  feature_refs text[] [default: '{}', note: '關聯的 Feature 檔案']
  current_version integer [not null, default: 1]
  is_active boolean [default: true]
  created_by uuid
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  Note: 'Prompt 模板主表 — 存放當前生效版本。SSOT 來源：project/03_Prompt_Templates/'
}

Ref: prompt_templates.created_by > users.id

Table prompt_template_versions {
  id uuid [pk, default: `gen_random_uuid()`]
  template_id uuid [not null]
  version integer [not null]
  model varchar(100) [not null]
  max_tokens integer [not null]
  max_tokens_by_plan jsonb
  temperature decimal(2,1) [not null]
  system_prompt text [not null]
  user_prompt text [not null]
  variables jsonb [not null, default: '[]']
  change_note text [note: '版本變更說明']
  created_by uuid
  created_at timestamptz [default: `now()`]

  indexes {
    (template_id, version) [unique]
  }

  Note: 'Prompt 版本歷史 — Append-only, immutable'
}

Ref: prompt_template_versions.template_id > prompt_templates.id [delete: cascade]
Ref: prompt_template_versions.created_by > users.id

Table prompt_ab_tests {
  id uuid [pk, default: `gen_random_uuid()`]
  template_id uuid [not null]
  name varchar(200) [not null, note: 'A/B 測試名稱 e.g. "教練語氣對比"']
  variant_a_version integer [not null, note: '對照組版本號']
  variant_b_system_prompt text [not null]
  variant_b_user_prompt text [not null]
  variant_b_temperature decimal(2,1)
  traffic_split integer [not null, default: 50, note: 'variant B 流量百分比 (0-100)']
  status ab_test_status [default: 'running']
  metric_name varchar(100) [note: '追蹤指標：accuracy / satisfaction / cost']
  variant_a_metric_value decimal(10,4) [note: 'A 組指標值']
  variant_b_metric_value decimal(10,4) [note: 'B 組指標值']
  winner varchar(1) [note: 'A / B / null (未決)']
  started_at timestamptz [default: `now()`]
  ended_at timestamptz
  created_by uuid [not null]
  created_at timestamptz [default: `now()`]

  Note: 'Prompt A/B 測試 — 同一模板最多一個 running 測試'
}

Ref: prompt_ab_tests.template_id > prompt_templates.id [delete: cascade]
Ref: prompt_ab_tests.created_by > users.id

// ── ORM 新增表（Migration 036-040）─────────────────────────────────

Table merge_conflicts {
  id uuid [pk, default: `gen_random_uuid()`]
  source_node_id uuid [not null]
  target_node_id uuid [not null]
  conflict_type varchar(50) [not null, note: 'name_mismatch / hierarchy_conflict / duplicate']
  resolution varchar(50) [note: 'merged / kept_source / kept_target / manual']
  resolved_by uuid
  resolved_at timestamptz
  metadata_json jsonb
  created_at timestamptz [default: `now()`]
}

Ref: merge_conflicts.source_node_id > knowledge_nodes.id
Ref: merge_conflicts.target_node_id > knowledge_nodes.id
Ref: merge_conflicts.resolved_by > users.id

Table merge_histories {
  id uuid [pk, default: `gen_random_uuid()`]
  source_node_id uuid [not null]
  target_node_id uuid [not null]
  merge_type varchar(50) [not null]
  merged_by uuid [not null]
  rollback_data jsonb [note: '合併前的快照，供 undo 使用']
  created_at timestamptz [default: `now()`]
}

Ref: merge_histories.source_node_id > knowledge_nodes.id
Ref: merge_histories.target_node_id > knowledge_nodes.id
Ref: merge_histories.merged_by > users.id

Table prompt_templates_v2 {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(100) [unique, not null, note: '模板唯一名稱，如 stage_1_planning']
  category varchar(50) [not null, note: 'exam_gen / coach / classification']
  description text
  system_prompt text [not null]
  user_prompt text [not null]
  model_name varchar(50) [default: 'claude-3-haiku']
  temperature decimal(3,2) [default: 0.7]
  max_tokens integer [default: 4096]
  is_active boolean [default: true]
  current_version integer [default: 1]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table prompt_template_versions {
  id uuid [pk, default: `gen_random_uuid()`]
  template_id uuid [not null]
  version integer [not null]
  system_prompt text [not null]
  user_prompt text [not null]
  change_note text
  created_by uuid
  created_at timestamptz [default: `now()`]
}

Ref: prompt_template_versions.template_id > prompt_templates_v2.id [delete: cascade]

Table prompt_template_history {
  id uuid [pk, default: `gen_random_uuid()`]
  template_id uuid [not null]
  version integer [not null]
  content text [not null]
  changed_by uuid
  created_at timestamptz [default: `now()`]
}

Ref: prompt_template_history.template_id > prompt_templates.id [delete: cascade]

Table historical_exams {
  id uuid [pk, default: `gen_random_uuid()`]
  exam_code varchar(50) [not null, note: '考試代碼，如 114010 或 FIN114']
  category_code varchar(100) [note: '類科代碼，如 501 或 securities']
  subject_code varchar(100) [note: '科目代碼，如 0101']
  exam_name varchar(255) [note: '考試名稱']
  category_name varchar(255) [note: '類科名稱']
  subject_name varchar(255) [note: '科目名稱']
  source varchar(255) [default: '考選部考畢試題查詢平臺']
  total_questions integer
  year integer [note: '民國年']
  tenant_id uuid
  created_at timestamptz [default: `now()`]

  indexes {
    (exam_code, category_code, subject_code) [unique, name: 'uq_historical_exam_identity']
    tenant_id
    exam_code
    year
  }

  Note: '考古題考試目錄 — 爬蟲匯入的考試元資料'
}

Ref: questions.historical_exam_id > historical_exams.id [delete: cascade]

// ============================================================
// Feature 33 — 成本監控中心（Cost Monitor）
// ============================================================

Table ai_usage_ledger {
  id uuid [pk, default: `gen_random_uuid()`]
  provider varchar(32) [not null, note: 'anthropic / gemini / voyage']
  endpoint varchar(128) [note: '呼叫的 API endpoint 或模型名稱']
  request_id varchar(128) [note: '對應 HTTP request id 或 trace id']
  input_tokens integer [default: 0]
  output_tokens integer [default: 0]
  cost_usd decimal(12,6) [not null, default: 0, note: '應用層換算的美元成本']
  billing_source varchar(16) [default: 'app', note: 'app / provider_api（若後續對帳）']
  user_id uuid [note: '觸發呼叫的使用者，允許 null（系統排程）']
  feature varchar(64) [note: '觸發來源：ai_gen / coach / embedding / mindmap']
  created_at timestamptz [default: `now()`, not null]

  indexes {
    (provider, created_at) [name: 'idx_ai_usage_ledger_provider_date']
    created_at
    user_id
  }

  Note: 'AI 呼叫的 token 級用量明細，供成本監控與配額鎖查詢'
}

Ref: ai_usage_ledger.user_id > users.id [delete: set null]

Table budget_config {
  id uuid [pk, default: `gen_random_uuid()`]
  scope varchar(32) [unique, not null, note: 'AI_ANTHROPIC / AI_GEMINI / AI_VOYAGE / GCP_TOTAL']
  monthly_limit_usd decimal(12,2) [not null]
  warning_percent integer [default: 50]
  degrade_percent integer [default: 80]
  disable_percent integer [default: 100]
  current_state varchar(16) [default: 'active', note: 'active / warning / degraded / disabled']
  overridden_until timestamptz [note: '手動解除停用的到期時間']
  updated_by uuid [note: '最後修改人（super_admin user_id）']
  created_at timestamptz [default: `now()`, not null]
  updated_at timestamptz [default: `now()`, not null]

  Note: '成本監控的預算設定與當前狀態'
}

Ref: budget_config.updated_by > users.id [delete: set null]

Table budget_alert_log {
  id uuid [pk, default: `gen_random_uuid()`]
  scope varchar(32) [not null]
  alert_type varchar(16) [not null, note: 'WARNING / DEGRADE / DISABLED']
  triggered_at_usd decimal(12,2) [not null]
  limit_usd decimal(12,2) [not null]
  percent decimal(5,2) [not null]
  notified_channels jsonb [note: '已送出的通知管道列表，如 ["email","in_app"]']
  resolved_at timestamptz
  created_at timestamptz [default: `now()`, not null]

  indexes {
    (scope, created_at) [name: 'idx_budget_alert_log_scope_date']
  }

  Note: '預算告警歷史紀錄'
}

// ── Sprint 11 #2 AI 補洞鷹架（migration 093）────────────────────────────

// resource_scaffolds 新增欄位（見 migration 093）
// trust_level varchar(32) [null, note: 'HUMAN_VERIFIED / SYSTEM_GENERATED / AI_INFERRED / PENDING_REVIEW']
// confidence_score integer [null, note: 'AI 補洞信心分數 0-100']
// evidence_question_ids uuid[] [null, note: '佐證考古題 id 陣列（最多 8 題）']
// is_orphan_fill boolean [not null, default: false, note: '是否為 AI 補洞鷹架（K-ORPHAN-01）']
// generation_failure_reason varchar(64) [null, note: 'evidence_insufficient / semantic_drift / url_detected / llm_error']
// resource_id 改為 nullable（orphan scaffold 無對應 resource）

Table scaffold_review_queue {
  id uuid [pk, default: `gen_random_uuid()`]
  scaffold_id uuid [not null, ref: > resource_scaffolds.id, note: 'CASCADE 刪除']
  reporter_user_id uuid [not null, ref: > users.id, note: 'CASCADE 刪除']
  reason_code varchar(32) [not null, note: 'definition_wrong / example_wrong / answer_wrong / unrelated / other']
  note varchar(100) [null, note: '自由填寫說明（限 100 字）']
  tenant_id uuid [null, note: '多租戶隔離鍵（RLS）']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    scaffold_id [name: 'ix_scaffold_review_queue_scaffold_id']
    tenant_id [name: 'ix_scaffold_review_queue_tenant']
  }

  Note: 'AI 補洞鷹架不準確回報佇列；RLS 啟用 tenant_id 隔離。≥3 份回報自動 trust_level → PENDING_REVIEW'
}
