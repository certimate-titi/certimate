// CertiMate Entity-Relationship Model
// Generated from .feature specifications
// Database: Cloud SQL (PostgreSQL)

// ============================================================
// Enums
// ============================================================

Enum subscription_plan {
  FREE
  PRO_199
  PRO_PLUS_399
  ULTRA_1599
  EDU
}

Enum user_status {
  pending       [note: '待驗證，尚未完成 Email 驗證']
  active
  suspended
  cooling
  deleted
}

Enum user_role {
  user
  student
  org_admin
  admin
  super_admin
}

Enum resource_type {
  pdf
  markdown
  txt
  image
  youtube
}

Enum resource_status {
  PENDING
  PROCESSING
  COMPLETED
  COMPLETED_NO_MAP
  FAILED
  PENDING_BUDGET_RECOVERY // Feature 33 — 當 AI_VOYAGE 達 80% 降級門檻時，新上傳資源進入此狀態等待預算恢復
}

Enum resource_scope {
  personal
  institution
}

Enum exam_status {
  PENDING       // AI 正在生成
  READY         // 生成完成，可開始
  IN_PROGRESS   // 作答中
  SUBMITTED     // 已交卷
}

Enum question_type {
  single_choice
  multiple_choice
  fill_in
  calculation
}

Enum difficulty_level {
  easy
  medium
  hard
}

Enum bloom_category {
  remember      // 記憶類別：考核知識點的記憶與回想
  understand    // 理解類別：考核概念解釋與詮釋能力
  apply         // 應用類別：考核將知識應用於新情境
  analyze       // 分析類別：考核拆解資訊與找出關聯
  evaluate      // 評估類別：考核做出判斷與評論
  create        // 創造類別：考核整合知識產出新方案
}

Enum learning_mode {
  final       // ≤7 天，最後衝刺（純鞏固已遇過題目）
  sprint      // 8-30 天，短期衝刺（重複錯題鞏固為主）
  standard    // 31-180 天，標準節奏（探索與複習平衡）
  mastery     // >180 天，廣讀探索（多新題覆蓋）
}

Enum self_assessed_level {
  beginner
  intermediate
  advanced
}

Enum learning_preference {
  drill       // 大量刷題
  concept     // 觀念理解優先
  mixed       // 混合模式
}

Enum quest_type {
  quiz
  explore
  review
}

Enum quest_status {
  pending
  completed
}

Enum subscription_status {
  active
  cancelled       // 已取消但未到期
  expired
  trial           // 14天免費試用中
}

Enum announcement_type {
  info
  maintenance
  feature
  warning
}

Enum display_mode {
  banner
  notification
  email
}

Enum discount_type {
  percentage
  fixed_amount
  free_trial_days
}

Enum refund_status {
  pending
  approved
  rejected
}

Enum report_type {
  inappropriate
  copyright
  bug_report
  other
}

Enum report_status {
  pending
  resolved
  dismissed
}

Enum assignment_status {
  pending
  active
  expired
}

Enum reverse_engineering_status {
  PROCESSING
  COMPLETED
  FAILED
}

Enum exam_frequency {
  high
  medium
  low
}

Enum source_origin {
  exam       [note: '考古題逆向萃取']
  document   [note: '教材順向萃取']
  manual     [note: '手動 Markdown 匯入']
}

Enum anomaly_status {
  pending         [note: '待處理']
  investigating   [note: '調查中']
  resolved        [note: '已解決']
  dismissed       [note: '已忽略']
}

Enum maintenance_priority {
  low
  medium
  high
  critical
}

Enum maintenance_task_status {
  pending
  in_progress
  completed
  cancelled
}

Enum maintenance_schedule_status {
  scheduled
  active
  completed
}

// ============================================================
// Multi-Tenant (Feature 31 — Phase 1)
// ============================================================

Enum tenant_plan_tier {
  b2c          [note: '預設 B2C 散客方案']
  b2b_basic    [note: 'B2B 基本（補習班）']
  b2b_pro      [note: 'B2B 進階（中型機構）']
  b2b_enterprise [note: 'B2B 企業（大型機構）']
}

Table tenants {
  id uuid [pk, default: `gen_random_uuid()`]
  slug varchar(100) [unique, not null, note: '唯一識別碼，如 public_b2c / institution_xyz']
  name varchar(255) [not null, note: '顯示名稱']
  plan_tier tenant_plan_tier [default: 'b2c', not null]
  is_active boolean [default: true, not null]
  max_users integer [note: 'B2B 授權人數上限，B2C 為 NULL']
  storage_quota_bytes bigint [note: '儲存容量配額，NULL = 無限制']
  llm_monthly_budget_usd decimal(10,2) [note: '每月 LLM 預算上限（美元）']
  metadata_json json [note: '可擴充租戶設定（SSO config, domain whitelist…）']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  indexes {
    slug [unique]
    plan_tier
  }

  Note: '''
  預設租戶 public_b2c（UUID: 00000000-0000-0000-0000-000000b2cb2c）
  由 migration 038 植入，不可刪除。
  RLS Policy: resource_chunks, answers 強制啟用 tenant_id 隔離。
  '''
}

// ============================================================
// Core User & Auth
// ============================================================

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [unique, not null]
  display_name varchar(100)
  avatar_url text
  auth_provider varchar(20) [default: 'email', note: 'email | google | github']
  password_hash text [note: 'null for SSO users']
  subscription_plan subscription_plan [default: 'FREE']
  subscription_status subscription_status [default: 'active']
  next_billing_date timestamptz
  stripe_customer_id varchar(100)
  trial_start_date timestamptz
  trial_end_date timestamptz
  has_used_trial boolean [default: false]
  pre_trial_plan varchar(20) [note: '試用前原方案，到期後降回']
  org_id uuid [ref: > institutions.id, note: 'EDU 學生所屬機構']
  role user_role [default: 'user']
  status user_status [default: 'active']
  onboarding_completed boolean [default: false]
  daily_study_minutes integer [default: 30]
  learning_preference learning_preference [default: 'mixed']
  age integer
  education varchar(100)
  career varchar(100)
  agreed_to_terms boolean [default: false]
  last_login_at timestamptz
  notification_preferences jsonb [default: '{}', note: 'F22 通知偏好：daily_reminder / pre_exam_reminder / weekly_report 等開關（前端 fetch + PATCH /account/notification-preferences 維護）']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table admin_roles {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, unique]
  role varchar(20) [not null, note: 'super_admin | admin']
  permissions jsonb [default: '{}']
  created_by uuid
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Ref: admin_roles.user_id > users.id [delete: cascade]
Ref: admin_roles.created_by > users.id

// ============================================================
// Subjects & Learning Journeys
// ============================================================

Table subject_categories {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(50) [not null, note: 'IT / 金融 / 語言 / 醫療 / 公務員 / 其他']
  sort_order integer [default: 0]
}

Table subjects {
  id uuid [pk, default: `gen_random_uuid()`]
  category_id uuid [not null]
  parent_subject_id uuid [ref: > subjects.id, note: '父科目 ID（子科目如「初級」「中級」指向主科目）']
  name varchar(200) [not null]
  name_en varchar(200)
  description text
  is_popular boolean [default: false]
  created_at timestamptz [default: `now()`]
}

Ref: subjects.category_id > subject_categories.id

Table learning_journeys {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  subject_id uuid [not null]
  exam_date date
  result_date date [note: '放榜日期']
  exam_result_status varchar(20) [note: 'NULL / passed / failed / retake']
  data_expiry_date date [note: '資料預定刪除日期']
  self_assessed_level self_assessed_level [default: 'beginner']
  learning_mode learning_mode [default: 'standard']
  is_archived boolean [default: false, note: '移除科目時封存而非刪除']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  indexes {
    (user_id, subject_id) [unique, note: '每人每科僅一個歷程']
  }
}

Ref: learning_journeys.user_id > users.id [delete: cascade]
Ref: learning_journeys.subject_id > subjects.id [delete: cascade]

// ============================================================
// Resources & Knowledge Map
// ============================================================

Table resources {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  subject_id uuid [not null]
  institution_id uuid [note: 'non-null = 機構共享資源']
  tenant_id uuid [note: '多租戶隔離鍵（Phase 1）']
  name varchar(500) [not null]
  type resource_type [not null]
  scope resource_scope [default: 'personal']
  status resource_status [default: 'PENDING']
  file_size_bytes bigint
  gcs_path text [note: '處理完成後靜默刪除原始檔']
  youtube_url text
  processing_engine varchar(50) [note: 'gemini-flash | vision-ocr | etc.']
  implicit_consent boolean [default: true]
  tags text[] [default: '{}']
  error_message text [note: 'FAILED 時的失敗原因']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  indexes {
    tenant_id
  }
}

Ref: resources.user_id > users.id [delete: cascade]
Ref: resources.subject_id > subjects.id [delete: cascade]
Ref: resources.institution_id > institutions.id

Table knowledge_nodes {
  id uuid [pk, default: `gen_random_uuid()`]
  resource_id uuid [note: 'nullable — 教材萃取時有值']
  subject_id uuid [note: '考科 ID — 逆向工程時有值']
  parent_id uuid [note: 'null = 根節點']
  name varchar(300) [not null]
  depth integer [default: 0]
  sort_order integer [default: 0]
  source_page_number integer [note: 'PDF 頁碼']
  source_timestamp_seconds integer [note: 'YouTube 時間戳（秒）']
  source_text text [note: '萃取的原文片段']
  available_questions integer [default: 0]
  exam_frequency varchar(10) [note: 'high/medium/low — 出題頻率']
  source_origin varchar(20) [default: 'document', note: 'exam/document/manual']
  node_type varchar(20) [default: 'syllabus', note: 'syllabus=考科官方知識架構(Feature 26/29) / personal=用戶個人學習節點(Feature 03/04/27)']
  created_at timestamptz [default: `now()`]
}

Ref: knowledge_nodes.resource_id > resources.id [delete: cascade]
Ref: knowledge_nodes.subject_id > subjects.id [delete: cascade]
Ref: knowledge_nodes.parent_id > knowledge_nodes.id

Table resource_chunks {
  id uuid [pk, default: `gen_random_uuid()`]
  resource_id uuid [not null]
  node_id uuid [note: '關聯的知識節點']
  tenant_id uuid [note: '多租戶隔離鍵（Phase 1）— RLS 強制啟用']
  chunk_index integer [not null]
  content text [not null]
  token_count integer [not null]
  source_page_start integer [note: 'PDF 起始頁碼']
  source_page_end integer [note: 'PDF 結束頁碼']
  anchor_id varchar(255) [note: '文件內錨點 ID（PDF: page_N, HTML: heading ID, YouTube: timestamp）']
  highlight_line_start integer [note: '原文高亮起始行（1-based）']
  highlight_line_end integer [note: '原文高亮結束行（1-based, inclusive）']
  highlight_char_start integer [note: '原文高亮起始字元偏移（0-based）']
  highlight_char_end integer [note: '原文高亮結束字元偏移（0-based, exclusive）']
  metadata_json json [note: '額外中繼資料']
  embedding "vector(1024)" [note: 'Voyage AI voyage-3 embedding（Phase 1 預設）']
  embedding_provider varchar(32) [default: 'voyage', note: 'Feature 33 — 記錄此 chunk 使用的 embedding provider，供未來多 provider 並存時分流查詢']
  embedding_model varchar(64) [default: 'voyage-3', note: 'Feature 33 — 記錄具體模型版本，供重嵌決策']
  created_at timestamptz [default: `now()`]

  indexes {
    resource_id
    tenant_id
    (embedding) [type: hnsw, note: 'vector_cosine_ops, m=16, ef_construction=64（Phase 1 升級）']
  }

  Note: 'RLS: ALTER TABLE resource_chunks ENABLE ROW LEVEL SECURITY'
}

Ref: resource_chunks.resource_id > resources.id [delete: cascade]
Ref: resource_chunks.node_id > knowledge_nodes.id [delete: set null]

// ============================================================
// Reverse Engineering (Feature 26)
// ============================================================

Table reverse_engineering_tasks {
  id uuid [pk, default: `gen_random_uuid()`]
  subject_id uuid [not null]
  triggered_by uuid [not null]
  status reverse_engineering_status [default: 'PROCESSING']
  total_questions integer [not null, note: '輸入的考古題總數']
  node_count integer [note: '產出的知識節點數']
  coverage_rate decimal(5,2) [note: '題目覆蓋率（已映射/總題數）']
  max_depth integer [note: '最大層級深度']
  orphan_node_count integer [default: 0, note: '無題目對應的孤立節點數']
  reliability varchar(10) [note: 'green/yellow/red']
  error_message text
  completed_at timestamptz
  created_at timestamptz [default: `now()`]
}

Ref: reverse_engineering_tasks.subject_id > subjects.id [delete: cascade]
Ref: reverse_engineering_tasks.triggered_by > users.id

Table node_mastery {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  node_id uuid [not null]
  correct_count integer [default: 0]
  total_count integer [default: 0]
  mastery_rate decimal(5,2) [default: 0, note: '答對率百分比']
  color varchar(10) [note: 'green ≥80 / orange 60-79 / red <60 / gray 未測']
  updated_at timestamptz [default: `now()`]

  indexes {
    (user_id, node_id) [unique]
  }
}

Ref: node_mastery.user_id > users.id [delete: cascade]
Ref: node_mastery.node_id > knowledge_nodes.id [delete: cascade]

// ============================================================
// Exams & Questions
// ============================================================

Table exams {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  subject_id uuid [not null]
  institution_assignment_id uuid [note: 'non-null = B2B 派發考卷']
  status exam_status [default: 'PENDING']
  total_questions integer [not null]
  duration_minutes integer
  passing_score integer
  difficulty_distribution jsonb [note: '{"easy":30,"medium":50,"hard":20}']
  bloom_distribution jsonb [note: '{"remember":20,"understand":25,"apply":25,"analyze":15,"evaluate":10,"create":5} — 依考試趨勢分佈']
  question_types text[]
  score integer
  correct_count integer
  started_at timestamptz
  submitted_at timestamptz
  custom_point_ratio json [note: '教師自訂節點出題比例']
  custom_bloom_ratio json [note: '教師自訂 Bloom 配比']
  question_order_mode varchar(20) [default: 'interleaved', note: 'interleaved=交錯練習 / sequential=依難度排列 / grouped=集中練習']
  created_at timestamptz [default: `now()`]
}

Ref: exams.user_id > users.id [delete: cascade]
Ref: exams.subject_id > subjects.id [delete: cascade]

Table questions {
  id uuid [pk, default: `gen_random_uuid()`]
  exam_id uuid [note: 'NULL for historical questions（使用者考試 FK）']
  historical_exam_id uuid [note: '爬蟲匯入考古題 FK（與 exam_id 互斥）']
  node_id uuid
  question_number integer [not null]
  type question_type [default: 'single_choice']
  difficulty difficulty_level [default: 'medium']
  bloom_category bloom_category [note: 'Bloom 認知層次分類，用於考試趨勢分析與難度分佈']
  content text [not null, note: '支援 Markdown + KaTeX']
  option_a text
  option_b text
  option_c text
  option_d text
  correct_answer varchar(10) [not null]
  explanation text [note: 'AI 生成的詳解（Markdown）']
  source_citation text [note: '原文溯源引用']
  historical_source varchar(255) [note: '考古題來源：如 "112年第1次金融業務人員"']
  source_type varchar(20) [default: 'historical', note: 'historical / ai_generated']
  quality_flag varchar(20) [default: 'ok', note: '品質標記：ok / review / low']
  flag_reason text [note: '品質問題說明']
  validation_model varchar(50) [note: 'AI 驗證模型名稱']
  expires_at timestamptz [note: 'AI 題過期時間，NULL = 永不過期（考古題）']
  retired_at timestamptz [note: '軟刪除時間']
  retention_reason varchar(50) [note: '保留/退場原因']
  suggested_node_id uuid [note: 'AI 建議歸屬節點（逆向工程未映射時）']
}

Ref: questions.exam_id > exams.id [delete: cascade]
Ref: questions.node_id > knowledge_nodes.id
Ref: questions.suggested_node_id > knowledge_nodes.id

Table answers {
  id uuid [pk, default: `gen_random_uuid()`]
  exam_id uuid [not null]
  question_id uuid [not null]
  user_id uuid [not null]
  tenant_id uuid [note: '多租戶隔離鍵（Phase 1）— RLS 強制啟用（含個資）']
  selected_answer varchar(10)
  is_correct boolean
  marked_for_review boolean [default: false]
  answered_at timestamptz

  indexes {
    (exam_id, question_id, user_id) [unique]
    tenant_id
  }

  Note: 'RLS: ALTER TABLE answers ENABLE ROW LEVEL SECURITY（含成績個資）'
}

Ref: answers.exam_id > exams.id [delete: cascade]
Ref: answers.question_id > questions.id [delete: cascade]
Ref: answers.user_id > users.id [delete: cascade]

// ============================================================
// Learning Schedule (SuperMemo-2)
// ============================================================

Table question_stats {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  node_id uuid [not null]
  success_count integer [default: 0]
  fail_count integer [default: 0]
  ease_factor decimal(4,2) [default: 2.5]
  next_review_date date
  updated_at timestamptz [default: `now()`]

  indexes {
    (user_id, node_id) [unique]
  }
}

Ref: question_stats.user_id > users.id [delete: cascade]
Ref: question_stats.node_id > knowledge_nodes.id [delete: cascade]

// ============================================================
// AI Coach Chat
// ============================================================

Table ai_chat_sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  context_type varchar(20) [not null, note: 'knowledge_node | error_review']
  context_id uuid [not null, note: 'nodeId or questionId']
  model_used varchar(50) [note: 'claude-3.5-sonnet | gemini-flash']
  message_count integer [default: 0]
  tenant_id uuid [note: '多租戶隔離鍵（NULL = public_b2c）']
  // Migration 094：Orphan Coach 蘇格拉底對話欄位
  mode varchar(32) [note: 'error_explanation | socratic_orphan；NULL = 舊資料相容']
  node_id uuid [note: 'socratic_orphan 模式：FK → knowledge_nodes']
  score_concept float [note: '最新輪概念接觸度（0/0.5/1）']
  score_reasoning float [note: '最新輪推理連結度（0/0.5/1）']
  score_initiative float [note: '最新輪主動性（0/0.5，規則判斷）']
  final_score float [note: '最新輪總分（最高 2.5）']
  mastery_committed boolean [default: false, note: '蘇格拉底 mastery 降權是否已寫入 node_mastery']
  paused_at timestamptz [note: 'C.4.4：3 分鐘無回應暫停時間']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Ref: ai_chat_sessions.user_id > users.id [delete: cascade]
Ref: ai_chat_sessions.node_id > knowledge_nodes.id [delete: cascade]

Table ai_chat_messages {
  id uuid [pk, default: `gen_random_uuid()`]
  session_id uuid [not null]
  role varchar(10) [not null, note: 'user | assistant | system']
  content text [not null]
  token_count integer
  // Migration 094：每輪評分（僅 user role 有值）
  score_concept float [note: '該輪概念接觸度（0/0.5/1）']
  score_reasoning float [note: '該輪推理連結度（0/0.5/1）']
  score_initiative float [note: '該輪主動性（0/0.5）']
  round_score float [note: '該輪總分（最高 2.5）']
  created_at timestamptz [default: `now()`]
}

Ref: ai_chat_messages.session_id > ai_chat_sessions.id [delete: cascade]

Table ai_cooldowns {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  reason varchar(100) [note: '10min_5_out_of_scope | token_abuse']
  cooldown_until timestamptz [not null]
  created_at timestamptz [default: `now()`]
}

Ref: ai_cooldowns.user_id > users.id [delete: cascade]

// ============================================================
// Gamification
// ============================================================

Table streaks {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, unique]
  current_streak integer [default: 0]
  longest_streak integer [default: 0]
  freeze_available boolean [default: true, note: '斷連保護冰凍，每人1次免費']
  last_active_date date
  updated_at timestamptz [default: `now()`]
}

Ref: streaks.user_id > users.id [delete: cascade]

Table daily_quests {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  quest_type quest_type [not null]
  description text [not null]
  target_count integer [default: 1]
  current_count integer [default: 0]
  status quest_status [default: 'pending']
  xp_reward integer [default: 10]
  quest_date date [not null]
  completed_at timestamptz

  indexes {
    (user_id, quest_date, quest_type) [unique]
  }
}

Ref: daily_quests.user_id > users.id [delete: cascade]

Table achievements {
  id uuid [pk, default: `gen_random_uuid()`]
  key varchar(100) [unique, not null, note: 'first_upload, first_pass, streak_7, etc.']
  name varchar(200) [not null]
  description text
  icon_url text
}

Table user_achievements {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  achievement_id uuid [not null]
  unlocked_at timestamptz [default: `now()`]

  indexes {
    (user_id, achievement_id) [unique]
  }
}

Ref: user_achievements.user_id > users.id [delete: cascade]
Ref: user_achievements.achievement_id > achievements.id

// ============================================================
// Subscriptions & Billing
// ============================================================

Table invoices {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  stripe_invoice_id varchar(200)
  amount decimal(10,2) [not null]
  currency varchar(3) [default: 'TWD']
  plan subscription_plan [not null]
  status varchar(20) [note: 'success | failed | refunded']
  created_at timestamptz [default: `now()`]
}

Ref: invoices.user_id > users.id [delete: cascade]

Table transactions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  merchant_trade_no varchar(20) [unique, not null, note: '綠界交易編號']
  target_plan varchar(50) [not null]
  amount decimal(10,2) [not null]
  status varchar(20) [not null, default: 'pending', note: 'pending | success | failed']
  payment_provider varchar(20) [not null, default: 'ecpay']
  trade_no varchar(50) [note: '綠界回傳的交易序號']
  payment_type varchar(50) [note: '付款方式，如 Credit_CreditCard']
  rtn_code varchar(20) [note: '綠界回傳碼']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Ref: transactions.user_id > users.id [delete: cascade]

// ============================================================
// B2B Institution
// ============================================================

Table institutions {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(200) [not null]
  admin_user_id uuid [not null]
  dpa_signed_at timestamptz
  dpa_signer_name varchar(100)
  edu_student_limit int [default: 30]
  surcharge_confirmed boolean [default: false]
  created_at timestamptz [default: `now()`]
}

Ref: institutions.admin_user_id > users.id

Table student_groups {
  id uuid [pk, default: `gen_random_uuid()`]
  institution_id uuid [not null]
  name varchar(200) [not null]
  created_at timestamptz [default: `now()`]
}

Ref: student_groups.institution_id > institutions.id [delete: cascade]

Table student_group_members {
  id uuid [pk, default: `gen_random_uuid()`]
  group_id uuid [not null]
  user_id uuid [not null]
  joined_at timestamptz [default: `now()`]

  indexes {
    (group_id, user_id) [unique]
  }
}

Ref: student_group_members.group_id > student_groups.id [delete: cascade]
Ref: student_group_members.user_id > users.id [delete: cascade]

Table institution_assignments {
  id uuid [pk, default: `gen_random_uuid()`]
  institution_id uuid [not null]
  group_id uuid [not null]
  created_by uuid [not null]
  exam_config jsonb [not null, note: 'nodeIds, questionCount, etc.']
  deadline timestamptz
  status assignment_status [default: 'pending']
  created_at timestamptz [default: `now()`]
}

Ref: institution_assignments.institution_id > institutions.id
Ref: institution_assignments.group_id > student_groups.id
Ref: institution_assignments.created_by > users.id

Table early_warning_rules {
  id uuid [pk, default: `gen_random_uuid()`]
  institution_id uuid [not null, unique]
  min_avg_score decimal(5,2) [default: 60]
  max_decline_trend integer [default: 3]
  max_inactive_days integer [default: 5]
  updated_at timestamptz [default: `now()`]
}

Ref: early_warning_rules.institution_id > institutions.id [delete: cascade]

// ============================================================
// Community & Proactive Care
// ============================================================

Table weekly_reports {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  report_week date [not null, note: '週一日期']
  study_hours decimal(5,1)
  exams_completed integer
  questions_answered integer
  progress_summary text [note: 'AI 生成摘要']
  created_at timestamptz [default: `now()`]

  indexes {
    (user_id, report_week) [unique]
  }
}

Ref: weekly_reports.user_id > users.id [delete: cascade]

// ============================================================
// Super Admin: Finance & Moderation
// ============================================================

Table admin_audit_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  admin_id uuid [not null]
  action varchar(100) [not null]
  target_type varchar(50)
  target_id uuid
  details jsonb
  ip_address inet
  user_agent text
  created_at timestamptz [default: `now()`]
  note: 'Append-only, immutable'
}

Ref: admin_audit_logs.admin_id > users.id

Table system_announcements {
  id uuid [pk, default: `gen_random_uuid()`]
  title varchar(255) [not null]
  content text [not null]
  type varchar(50) [default: 'info', note: 'info | warning | maintenance']
  display_mode varchar(50) [default: 'banner', note: 'banner | modal | toast']
  status varchar(20) [default: 'active', note: 'active | inactive']
  starts_at timestamptz
  ends_at timestamptz
  created_by uuid
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Ref: system_announcements.created_by > users.id

Table feature_flags {
  id uuid [pk, default: `gen_random_uuid()`]
  flag_key varchar(100) [unique, not null]
  enabled boolean [default: false]
  rollout_percentage integer [default: 0, note: '0-100']
  target_plans varchar(255) [note: 'comma-separated plan keys']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table coupons {  // ORM: Coupon（原名 promo_codes，已更名對齊 ORM）
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(50) [unique, not null]
  discount_type discount_type [not null]
  discount_value decimal(10,2) [not null]
  applicable_plans text[] [default: '{PRO_199,PRO_PLUS_399,ULTRA_1599}']
  max_uses integer
  max_uses_per_user integer [default: 1]
  current_uses integer [default: 0]
  valid_from timestamptz
  valid_until timestamptz
  is_active boolean [default: true]
  created_by uuid
  created_at timestamptz [default: `now()`]
}

Ref: coupons.created_by > users.id

Table refunds {  // ORM: Refund（原名 refund_requests，已更名對齊 ORM）
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  invoice_id uuid [not null]
  amount decimal(10,2) [not null]
  reason text
  status refund_status [default: 'pending']
  reviewed_by uuid
  review_note text
  reviewed_at timestamptz
  created_at timestamptz [default: `now()`]
}

Ref: refunds.user_id > users.id
Ref: refunds.invoice_id > invoices.id
Ref: refunds.reviewed_by > users.id

Table content_reports {
  id uuid [pk, default: `gen_random_uuid()`]
  report_ref varchar(50) [unique, not null, note: 'Business identifier e.g. RPT-001']
  reporter_id uuid [not null]
  report_type varchar(50) [not null, note: 'copyright | inappropriate | spam | other']
  target_type varchar(50) [not null]
  target_id varchar(100) [not null, note: 'Stored as string to support varied target types']
  description text
  status varchar(20) [default: 'pending', note: 'pending | resolved | dismissed']
  resolution_action varchar(50) [note: 'delete_and_warn | dismiss | warn_only']
  resolved_by varchar(50)
  resolution_note text
  resolved_at timestamptz
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Ref: content_reports.reporter_id > users.id
Ref: content_reports.resolved_by > users.id

Table ai_model_routings {
  id uuid [pk, default: `gen_random_uuid()`]
  plan varchar(50) [not null, note: 'FREE | PRO_199 | PRO_PLUS_399 | ULTRA_1599']
  task_type varchar(50) [not null, note: 'basic | advanced | vision_ocr']
  primary_model varchar(100) [not null, note: 'e.g. claude-sonnet-4-20250514']
  fallback_model varchar(100)
  updated_at timestamptz [default: `now()`]
}

Table plan_quotas {
  id uuid [pk, default: `gen_random_uuid()`]
  plan subscription_plan [not null, unique]
  monthly_uploads integer
  monthly_exams integer
  daily_ai_chats integer
  monthly_vision_pages integer
  max_file_size_mb integer
  updated_by uuid
  updated_at timestamptz [default: `now()`]
}

Ref: plan_quotas.updated_by > users.id

Table user_usage {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  period varchar(10) [not null, note: 'YYYY-MM format for monthly tracking']
  daily_ai_chats_used integer [default: 0]
  monthly_uploads_used integer [default: 0]
  monthly_exams_used integer [default: 0]
  monthly_vision_pages_used integer [default: 0]
  last_reset_at timestamptz [default: `now()`]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  indexes {
    (user_id, period) [unique]
  }
}

Ref: user_usage.user_id > users.id

// ============================================================
// Anomaly Tracking & Maintenance (Feature 16)
// ============================================================

Table anomaly_records {
  id uuid [pk, default: `gen_random_uuid()`]
  error_id varchar(50) [unique, not null, note: 'e.g. ERR-001']
  error_type varchar(200) [not null, note: 'e.g. Database Connection Timeout']
  occurrence_count integer [default: 1, not null]
  status anomaly_status [default: 'pending']
  impact_scope varchar(100) [not null, note: '全站 / AI 模組 / etc.']
  assigned_to varchar(200) [note: '指派的團隊或人員']
  first_seen_at timestamptz [not null, default: `now()`]
  last_seen_at timestamptz [not null, default: `now()`]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  Note: '異常紀錄，相似錯誤自動歸類彙整'
}

Table maintenance_tasks {
  id uuid [pk, default: `gen_random_uuid()`]
  task_id varchar(50) [unique, not null, note: 'e.g. MNT-001']
  name varchar(200) [not null]
  priority maintenance_priority [not null]
  related_error_id uuid [note: '關聯的異常紀錄']
  status maintenance_task_status [default: 'pending']
  estimated_hours decimal(5,1)
  created_by uuid [not null]
  assigned_to uuid
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  Note: '維修任務看板'
}

Ref: maintenance_tasks.related_error_id > anomaly_records.id
Ref: maintenance_tasks.created_by > users.id
Ref: maintenance_tasks.assigned_to > users.id

Table maintenance_schedules {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(200) [not null]
  status maintenance_schedule_status [default: 'scheduled']
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  notify_channels text[] [default: '{}', note: 'email, banner']
  notify_targets varchar(100) [note: 'all_subscribers / admin_only']
  notify_before text[] [default: '{}', note: 'e.g. 24h, 1h']
  reason text [note: '維修原因']
  is_full_site boolean [default: false, note: '全站維修模式']
  health_check_passed boolean [default: false]
  created_by uuid [not null]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  Note: '維修排程與全站維修模式'
}

Ref: maintenance_schedules.created_by > users.id

Table maintenance_notifications {
  id uuid [pk, default: `gen_random_uuid()`]
  schedule_id uuid [not null]
  scheduled_send_at timestamptz [not null]
  sent_at timestamptz
  created_at timestamptz [default: `now()`]

  Note: '維修排程的預排通知'
}

Ref: maintenance_notifications.schedule_id > maintenance_schedules.id [delete: cascade]

